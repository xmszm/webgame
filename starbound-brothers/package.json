    "@types/pngjs": "^6.0.5",
    "eslint": "^10.8.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
