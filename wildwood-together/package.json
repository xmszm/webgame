{
  "name": "wildwood-together",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check:artifacts": "node scripts/artifact-check.js",
    "validate": "npm run lint && npm test && npm run build && npm run test:e2e && npm run check:artifacts"
  },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": { "@playwright/test": "^1.55.0", "eslint": "^9.36.0", "vite": "^7.1.0" }
}
